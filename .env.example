# 取得後に .env.local へ。コミットしない。
REINFOLIB_API_KEY=
ESTAT_APP_ID=
OPENAI_API_KEY=

# --- GSC分析ツール（scripts/gsc/, npm run gsc:analyze）---
# 対象プロパティ。ドメインプロパティなら sc-domain:kurashimap.jp、
# URLプレフィックスプロパティなら https://kurashimap.jp/ 。README「GSC分析ツールの認証設定」参照。
GSC_SITE_URL=sc-domain:kurashimap.jp
# サービスアカウント認証。以下のどちらか一方でよい。
#  1) JSONキーファイルのパスを指定（推奨）
GOOGLE_APPLICATION_CREDENTIALS=
#  2) クライアントメール＋秘密鍵を直接指定（\n は改行として解釈される）
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=

# --- マネタイズ導線（任意・クライアント公開値。秘密情報は入れないこと） ---
# 投げ銭・サポーター支援先URL（Ofuse / Buy Me a Coffee 等）。未設定なら支援ボタンは非表示。
NEXT_PUBLIC_SUPPORT_URL=
# ふるさと納税導線（アクセストレード×ふるなび提携済み 2026-08）。
# 以下のどちらか一方を設定すると自治体詳細ページの導線が点灯する（両方未設定なら非表示）。
#  1) 検索URLテンプレート。{keyword} を「県名+自治体名」で置換（ASPがリンク先自由型リンクを
#     許可している場合のみ。両方設定時はこちらを優先）。
#     例: https://h.accesstrade.net/sp/ic?rk=...&url=https%3A%2F%2Ffurunavi.jp%2Fsearch...{keyword}
NEXT_PUBLIC_FURUSATO_URL_TEMPLATE=
#  2) ASP発行の固定アフィリエイトリンク（アクセストレード管理画面 → プログラム詳細 →
#     広告素材のテキストリンクからURLを取得）。
#     例: https://h.accesstrade.net/sp/cc?rk=xxxxxxxxxxxx
NEXT_PUBLIC_FURUSATO_AFF_URL=
