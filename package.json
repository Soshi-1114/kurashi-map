{
  "name": "kurashi-map",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2 <23 || >=24.15.0"
  },
  "scripts": {
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:initial-view": "node scripts/build-initial-view-svg.mjs",
    "indexnow": "node scripts/indexnow-submit.mjs",
    "gsc:analyze": "tsx --env-file=.env.local scripts/gsc/analyze.ts",
    "gsc:inspect": "tsx --env-file=.env.local scripts/gsc/indexInspection.ts",
    "gsc:inspect:diff": "tsx scripts/gsc/indexInspectionDiff.ts",
    "gsc:audit-links": "tsx scripts/gsc/auditLinks.ts"
  },
  "dependencies": {
    "lucide-react": "^1.60.0",
    "maplibre-gl": "^6.15.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "minimatch@^10.2.6": {
      "brace-expansion": "^5.0.12"
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@turf/turf": "^7.4.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "google-auth-library": "^11.3.1",
    "jsdom": "^30.1.3",
    "mapshaper": "^0.7.93",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vitest": "^5.0.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
